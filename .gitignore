# Virtual environment
venv/
.venv/
env/
venv_anaconda_backup/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.pytest_cache/

# Jupyter checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Data files (large)
*.npz
*.npy
*.csv
*.zarr

# ...but pipeline outputs under experiments/ are small (<1MB total) and ARE the
# deliverable, so they must survive --git-push. Without this the evaluation
# stage could never resume across Kaggle sessions -- every table it writes is a
# CSV, and /kaggle/working is wiped when a session ends.
!experiments/**/*.csv

synthetic_drift_data/
old_notebooks/
feature_cache_disk/

# Executed-notebook copies written by scripts/run_replay_sweep_parallel.py
notebooks/**/*__RR_*.ipynb
notebooks/**/*__merge_verify.ipynb

# Orchestrator run logs (scripts/run_pipeline_stages.py)
pipeline_logs/
replay_sweep_logs/

# Transient files from checkpointing.py's atomic-write pattern (write-then-
# os.replace). Under normal operation these never outlive a single save call,
# but this guards the vanishingly small crash window between finishing the
# write and the rename, so a leftover .tmp can never get committed.
experiments/**/*.tmp

to do.md
# Model files (potentially large)
# Uncomment if you want to exclude model files:
# models/
# models_*/
# *.json

# Prediction visualizations (images, large folders)
prediction visualizations/
prediction visualizations huber/
prediction visualizations prevyears monthly features/
prediction visualizations with neighbourhoods/
